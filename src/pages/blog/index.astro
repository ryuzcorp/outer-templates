---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Base title="Blog" description="Posts, newest first.">
  <div class="flex flex-col gap-4">
    <h1 class="text-3xl font-bold">Blog</h1>
    {posts.length ? (
      <ul class="list rounded-box bg-base-200">
        {posts.map((post) => (
          <li class="list-row items-center">
            <a href={`/blog/${post.slug}`} class="list-col-grow link">
              {post.data.title}
            </a>
            <span class="badge badge-neutral">
              {post.data.date.toISOString().slice(0, 10)}
            </span>
          </li>
        ))}
      </ul>
    ) : (
      <div role="status" class="alert alert-soft">
        Nothing here yet. Add a Markdown file under src/content/posts/.
      </div>
    )}
  </div>
</Base>

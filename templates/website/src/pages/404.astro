---
// Unknown URLs land here (Astro renders 404.astro for them in static
// output). Same card style as the rest of the site.
import Base from "../layouts/Base.astro";
import { pageTitle } from "../lib/brand.ts";
---

<Base title={pageTitle("Not found")} description="This page does not exist.">
  <div class="card bg-base-100 shadow-sm">
    <div class="card-body items-center gap-4 py-12 text-center">
      <h1 class="card-title text-2xl">Page not found</h1>
      <p class="opacity-70">The link may be old, or the page may have moved.</p>
      <a href="/" class="btn btn-primary">Back home</a>
    </div>
  </div>
</Base>

---
// Who runs the site and how to reach them. Replace the copy with the real
// story; the layout, head tags, and styles stay.
import Base from "../layouts/Base.astro";
import { pageTitle, siteBrand } from "../lib/brand.ts";
---

<Base title={pageTitle("About")} description={`About ${siteBrand.name}.`}>
  <div class="flex flex-col gap-4">
    <h1 class="text-3xl font-bold">About</h1>
    <section class="card bg-base-100 shadow-sm">
      <div class="card-body gap-2">
        <h2 class="card-title text-xl">{siteBrand.name}</h2>
        <p class="opacity-70">{siteBrand.description}</p>
        <p class="opacity-70">
          This page is a starting point, not a story — replace it with who is
          behind the site and why it exists. The header, footer, and head tags
          read brand.json, so renaming the site never touches this file.
        </p>
      </div>
    </section>
    <section class="card bg-base-100 shadow-sm">
      <div class="card-body gap-2">
        <h2 class="card-title text-xl">Contact</h2>
        <p class="opacity-70">
          The fastest way to reach us is the newsletter on the{" "}
          <a href="/#newsletter" class="link">home page</a> — leave an email
          and every new post lands in your inbox.
        </p>
      </div>
    </section>
  </div>
</Base>

---
// The blog index, newest first. Drafts never build: the filter drops them
// and the `[slug]` route 404s them. Reading time comes from the raw post
// body (see `src/lib/posts.ts`).
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { pageTitle } from "../../lib/brand.ts";
import { postSlug, readingTime } from "../../lib/posts.ts";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Base title={pageTitle("Blog")} description="Posts, newest first.">
  <div class="flex flex-col gap-4">
    <h1 class="text-3xl font-bold">Blog</h1>
    {posts.length ? (
      <ul class="list rounded-box bg-base-200">
        {posts.map((post) => (
          <li class="list-row items-center">
            <a href={`/blog/${postSlug(post.id)}`} class="list-col-grow link">
              {post.data.title}
            </a>
            <span class="badge badge-neutral">
              {post.data.date.toISOString().slice(0, 10)} · {readingTime(post.body ?? "")} min
            </span>
          </li>
        ))}
      </ul>
    ) : (
      <div role="status" class="alert alert-soft">
        Nothing here yet. Add a Markdown file under src/content/posts/.
      </div>
    )}
  </div>
</Base>

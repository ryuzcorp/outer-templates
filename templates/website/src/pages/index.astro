---
// The home page: a polished branded landing from `brand.json`, with a
// neutral "nothing here yet" state that looks fine to a real end user who
// opens the link before the site is built. No demo copy, no sample posts,
// no signup form — those live in the `landing`, `blog`, and `newsletter`
// examples. Copy them over when the site needs them.
import Base from "../layouts/Base.astro";
import { pageTitle, siteBrand } from "../lib/brand.ts";
---

<Base title={pageTitle()} description={siteBrand.description}>
  <div class="flex flex-col gap-6">
    <section class="card bg-base-100 shadow-sm">
      <div class="card-body items-center gap-3 py-12 text-center sm:py-16">
        <h1 class="max-w-xl text-4xl leading-[1.05] font-extrabold tracking-tight sm:text-5xl">
          {siteBrand.name}
        </h1>
        <p class="max-w-lg text-lg opacity-70">{siteBrand.description}</p>
      </div>
    </section>
    <section aria-label="Coming soon" class="card bg-base-100 shadow-sm">
      <div class="card-body items-center gap-2 py-8 text-center">
        <p role="status" class="text-lg font-medium">Nothing here yet</p>
        <p class="max-w-xs text-sm opacity-70">
          This site is just getting started — check back soon to see what it becomes.
        </p>
      </div>
    </section>
  </div>
</Base>

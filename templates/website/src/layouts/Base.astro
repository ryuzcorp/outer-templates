---
// The brand in one place: `brand.json` names the site. Every head tag,
// the header, the footer, and the favicon render from it — edit it to
// rebrand, never the generated outputs. Base also sets the accent as the
// primary color in both themes, and reserves no badge space itself: Outer's
// proxy appends `#outer-badge` plus `--outer-badge-space` on Free pages,
// so the footer carries extra bottom padding and keeps its text centered,
// clear of the bottom-right corner.
import ThemeToggle from "../islands/ThemeToggle.tsx";
import { initials, onAccent, siteBrand } from "../lib/brand.ts";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = siteBrand.description, image = "/og.svg" } = Astro.props;
const fg = onAccent(siteBrand.accent);
// `Astro.url.pathname` is the output file (`/index.html`, `/404.html`),
// not the route: strip the filename so links can compare against it.
const path = Astro.url.pathname.replace(/(\/index)?\.html$/, "") || "/";
const links = [{ href: "/", label: "Home" }];
const isActive = (href: string) => path === href || (href !== "/" && path.startsWith(`${href}/`));
---

<!doctype html>
<html lang="en">
  <head>
    <!-- `charset` and `viewport` stay first: without the viewport, phones
      render a zoomed-out 980px desktop layout. -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={siteBrand.accent} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={siteBrand.shortName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteBrand.name} />
    <meta property="og:image" content={image} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${siteBrand.name} blog`} href="/rss.xml" />
    <!-- Apply the saved theme before first paint so the toggle never
      flashes the wrong one. The toggle keeps this in sync afterwards. -->
    <script is:inline>
      try {
        var saved = localStorage.getItem("theme");
        if (saved === "light" || saved === "dark") {
          document.documentElement.dataset.theme = saved;
        } else if (matchMedia("(prefers-color-scheme: dark)").matches) {
          document.documentElement.dataset.theme = "dark";
        }
      } catch (error) {}
    </script>
    <title>{title}</title>
  </head>
  <body>
    
    <div
      class="accent-scope flex min-h-dvh flex-col"
      style={`--color-primary:${siteBrand.accent};--color-primary-content:${fg}`}
    >
      <header class="navbar bg-base-100 shadow-sm">
        <div class="mx-auto flex w-full max-w-2xl flex-col px-4">
          <div class="flex w-full items-center justify-between gap-2 py-1">
            <a href="/" class="btn btn-ghost flex items-center gap-2 px-2 text-lg">
              <span
                aria-hidden="true"
                class="flex h-9 w-9 items-center justify-center rounded-lg text-base font-bold"
                style={`background:${siteBrand.accent};color:${fg}`}
              >
                {initials(siteBrand.name)}
              </span>
              {siteBrand.name}
            </a>
            <div class="flex items-center gap-1">
              {/* Roomier screens get the links up top; phones get the row below. */}
              <nav class="hidden items-center gap-1 sm:flex" aria-label="Primary">
                {
                  links.map((link) => (
                    <a
                      href={link.href}
                      aria-current={isActive(link.href) ? "page" : undefined}
                      class={`btn btn-ghost ${isActive(link.href) ? "text-ink" : ""}`}
                    >
                      {link.label}
                    </a>
                  ))
                }
              </nav>
              {/* Hydrates in place; static button HTML until it loads. */}
              <ThemeToggle client:load />
            </div>
          </div>
          <nav class="flex gap-1 overflow-x-auto pb-2 sm:hidden" aria-label="Primary">
            {
              links.map((link) => (
                <a
                  href={link.href}
                  aria-current={isActive(link.href) ? "page" : undefined}
                  class={`btn flex-1 ${isActive(link.href) ? "btn-primary" : "btn-ghost"}`}
                >
                  {link.label}
                </a>
              ))
            }
          </nav>
        </div>
      </header>
      <main class="mx-auto w-full max-w-2xl grow px-4 py-8 sm:py-12">
        <slot />
      </main>
      {/* Centered text stays clear of the bottom-right badge; the extra
        bottom padding is the badge's own strip on Free pages, 0 on Pro. */}
      <footer
        class="flex flex-col items-center gap-4 bg-base-200 px-6 pt-6 text-center text-sm"
        style="padding-bottom:calc(1.5rem + var(--outer-badge-space, 0px))"
      >
        <nav aria-label="Footer">
          <ul class="flex flex-wrap justify-center gap-x-5 gap-y-2">
            {
              links.map((link) => (
                <li>
                  <a href={link.href} class="link link-hover">
                    {link.label}
                  </a>
                </li>
              ))
            }
            <li><a href="/rss.xml" class="link link-hover">RSS</a></li>
          </ul>
        </nav>
        <p class="opacity-70">© {new Date().getFullYear()} {siteBrand.name}</p>
      </footer>
    </div>
  </body>
</html>

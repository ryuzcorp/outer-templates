{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["void/env", "astro/client", "vite/client", "bun", "@cloudflare/workers-types"],
    "jsx": "react-jsx",
    "jsxImportSource": "ilha",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src", "void.config.ts"]
}
